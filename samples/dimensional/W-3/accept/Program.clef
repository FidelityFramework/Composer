module Vet

[<Measure>] type m
[<Measure>] type s
[<Measure>] type kg
[<Measure>] type N = kg m / s^2

// A boundary width comes from the platform description: Addr is the Pointer width the
// binding declares (8 bytes under x86_64, 4 under the Cortex-M33 leaf); Tag's range is [1, 1].
type Pair = { Addr: Ptr<int, Stack, ReadOnly>; Tag: int }
let p (a: Ptr<int, Stack, ReadOnly>) = { Addr = a; Tag = 1 }

[<EntryPoint>]
let main _ = 0
