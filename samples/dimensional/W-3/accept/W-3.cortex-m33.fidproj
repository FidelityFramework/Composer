# Dimensional vet program (Dimensional_Vetting_Plan.md §3, Dimensional_Step1_2_Design.md §(g)).
# Cloned from BAREWire/samples/RoundTrip/RoundTrip.fidproj: name, description and source list
# adjusted; the barewire dependency dropped (the vet programs open nothing beyond the prelude).
# Compiled by vet.sh in this directory; never by tests/regression/Runner.fsx.

[package]
name = "W-3-accept-cortex-m33"
version = "0.1.0"
description = "W-3 accept under a Cortex-M33 descriptor (Pointer 32, Register 32): a seal at a platform boundary comes from the platform description, resolved in CCS at saturation, never in the witness"

[compilation]
target = "mcu"

[dependencies]
platform = { path = "/home/hhh/repos/Fidelity.Platform/MCU/Renesas/RA6M5/EK_RA6M5/Fidelity.Platform.fidproj" }

[build]
sources = [
    "Program.clef"
]
output = "vet"
output_kind = "freestanding"
