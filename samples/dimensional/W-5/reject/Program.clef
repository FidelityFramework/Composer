module Vet

[<Measure>] type m
[<Measure>] type s
[<Measure>] type kg
[<Measure>] type N = kg m / s^2

// A boundary the Contracts leaf declares 8 bits wide receives the range [300, 300]:
// CCS8012, a warning promoted under --warnaserror. Nothing is converted.
let w (reg8: Ptr<int, Peripheral, WriteOnly>) = Ptr.write reg8 300
let c (reg8: Ptr<int, Peripheral, WriteOnly>) (counter: int) = Ptr.write reg8 (counter % 1000)

[<EntryPoint>]
let main _ = 0
