[package]
name = "SignalTest"
version = "0.1.0"
description = "Test sample for Fidelity.Signal reactive primitives"
authors = ["SpeakEZ Technologies, Inc."]
license = "MIT"

[compilation]
target = "native"

[dependencies]
platform = { path = "/home/hhh/repos/Fidelity.Platform/Profiles/Linux_x86_64_Default/Fidelity.Platform.fidproj" }
signal = { path = "/home/hhh/repos/Fidelity.Signal/Fidelity.Signal.fidproj" }

[build]
sources = [
    "SignalTest.fs"
]
output = "signaltest"
output_kind = "freestanding"
