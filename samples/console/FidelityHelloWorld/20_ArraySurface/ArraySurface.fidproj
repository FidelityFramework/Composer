[package]
name = "ArraySurface"
version = "0.1.0"
description = "Array.length, array literals, indexers, Array.blit, for loops, arrays of records"
authors = ["SpeakEZ Technologies, Inc."]
license = "MIT"

[compilation]
target = "cpu"

[dependencies]
# Types and operations are CCS intrinsics - no external library needed
platform = { path = "/home/hhh/repos/Fidelity.Platform/CPU/Linux/x86_64/Fidelity.Platform.fidproj" }

[build]
sources = ["ArraySurface.fs"]
output = "arraysurface"
output_kind = "console"
