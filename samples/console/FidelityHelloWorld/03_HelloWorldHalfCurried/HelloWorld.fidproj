# HelloWorldHalfCurried - FidelityHelloWorld Sample 03
# Pattern: Pipe operator (|>), String.format, partial application

[package]
name = "HelloWorldHalfCurried"
version = "0.1.0"
description = "HelloWorld with pipe operators and partial application"
authors = ["SpeakEZ Technologies, Inc."]
license = "MIT"

[compilation]
target = "cpu"

[dependencies]
# Types and operations are CCS intrinsics - no external library needed
platform = { path = "/home/hhh/repos/Fidelity.Platform/Profiles/Linux_x86_64_Default/Fidelity.Platform.fidproj" }

[build]
sources = [
    "HelloWorld.fs"
]
output = "helloworld"
output_kind = "console"  # Requires libc for string operations (memcpy)
