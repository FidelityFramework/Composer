[package]
name = "Recursion"
version = "0.1.0"
description = "Demonstrates recursive functions and tail recursion"
authors = ["SpeakEZ Technologies, Inc."]
license = "MIT"

[compilation]
target = "cpu"

[dependencies]
# Types and operations are CCS intrinsics - no external library needed
platform = { path = "/home/hhh/repos/Fidelity.Platform/Profiles/Linux_x86_64_Default/Fidelity.Platform.fidproj" }

[build]
sources = ["Recursion.fs"]
output = "recursion"
output_kind = "console"
