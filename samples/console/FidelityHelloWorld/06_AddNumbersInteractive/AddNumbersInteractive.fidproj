[package]
name = "AddNumbers"
version = "0.1.0"
description = "Interactive discriminated unions with user input and parsing"
authors = ["SpeakEZ Technologies, Inc."]
license = "MIT"

[compilation]
target = "cpu"

[dependencies]
# Types and operations are CCS intrinsics - no external library needed
platform = { path = "/home/hhh/repos/Fidelity.Platform/Profiles/Linux_x86_64_Default/Fidelity.Platform.fidproj" }

[build]
sources = ["AddNumbersInteractive.fs"]
output = "addnumbers_interactive"
output_kind = "console"
