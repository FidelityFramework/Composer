[package]
name = "RecordsAndTags"
version = "0.1.0"
description = "Mutable record field through a parameter, enum union field, three-arm matches, string-tag equality"
authors = ["SpeakEZ Technologies, Inc."]
license = "MIT"

[compilation]
target = "cpu"

[dependencies]
# Types and operations are CCS intrinsics - no external library needed
platform = { path = "/home/hhh/repos/Fidelity.Platform/Profiles/Linux_x86_64_Default/Fidelity.Platform.fidproj" }

[build]
sources = ["RecordsAndTags.fs"]
output = "recordsandtags"
output_kind = "console"
