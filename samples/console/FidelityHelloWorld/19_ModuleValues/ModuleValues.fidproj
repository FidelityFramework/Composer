[package]
name = "ModuleValues"
version = "0.1.0"
description = "Module-level values: slots initialized before main, referenced across modules and functions"
authors = ["SpeakEZ Technologies, Inc."]
license = "MIT"

[compilation]
target = "cpu"

[dependencies]
# Types and operations are CCS intrinsics - no external library needed
platform = { path = "/home/hhh/repos/Fidelity.Platform/CPU/Linux/x86_64/Fidelity.Platform.fidproj" }

[build]
sources = ["ModuleValuesLib.fs", "ModuleValues.fs"]
output = "modulevalues"
output_kind = "console"
