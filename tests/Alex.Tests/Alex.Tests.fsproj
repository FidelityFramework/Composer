<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="ZipperTests.fs" />
    <Compile Include="IndexPatternTests.fs" />
    <Compile Include="MlirComponentTests.fs" />
    <Compile Include="FunctionResultTests.fs" />
    <Compile Include="StringBoundaryTests.fs" />
    <Compile Include="UnitResultTests.fs" />
    <Compile Include="IndexSwitchTests.fs" />
    <Compile Include="ContinuationPatternTests.fs" />
    <Compile Include="EnvironmentPatternTests.fs" />
    <Compile Include="CallableOperandTests.fs" />
    <Compile Include="CallableFlowTests.fs" />
    <Compile Include="CallableTransportTests.fs" />
    <Compile Include="SequenceTransportTests.fs" />
    <Compile Include="LazyOperandTests.fs" />
    <Compile Include="LazyTransportTests.fs" />
    <Compile Include="LambdaOccurrenceTests.fs" />
    <Compile Include="ControlFlowOccurrenceTests.fs" />
    <Compile Include="TraversalOccurrenceTests.fs" />
    <Compile Include="RequirementTests.fs" />
    <Compile Include="EagerWitnessTests.fs" />
    <Compile Include="RawConstantMatchTests.fs" />
    <Compile Include="LLVMRequirementTests.fs" />
    <Compile Include="WritableStorageTests.fs" />
    <Compile Include="AggregatePatternTests.fs" />
    <Compile Include="UnionLayoutPatternTests.fs" />
    <Compile Include="ProgramValuePatternTests.fs" />
    <Compile Include="ProgramSequencePatternTests.fs" />
    <Compile Include="MutableClosureTests.fs" />
    <Compile Include="CallableSymbolTests.fs" />
    <Compile Include="SequenceBoundaryTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../../src/Composer.fsproj" />
  </ItemGroup>
</Project>
