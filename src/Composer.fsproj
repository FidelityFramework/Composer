<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>composer</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Version>0.0.2</Version>
    <Description>Composer F# Compiler - Native Type Universe via CCS</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DisableImplicitSystemValueTupleReference>true</DisableImplicitSystemValueTupleReference>
  </PropertyGroup>

  <ItemGroup>
      <!-- Core Utilities -->
      <Compile Include="Core/Utilities/IntermediateWriter.fs" />
      <Compile Include="Core/Utilities/RemoveIntermediates.fs" />

      <!-- Compiler Configuration -->
      <Compile Include="Core/CompilerConfig.fs" />
      <Compile Include="Core/Timing.fs" />

      <!-- Core Types -->
      <Compile Include="Core/Types/Dialects.fs" />
      <Compile Include="Core/Types/Pipeline.fs" />

      <!-- Alex MLIR Type System (used by TypeMapping and Elements) -->
      <Compile Include="MiddleEnd/Alex/Dialects/Core/Types.fs" />
      <Compile Include="MiddleEnd/Alex/Dialects/Core/Serialize.fs" />

      <!-- CCS Integration (thin layer receiving SemanticGraph) -->
      <Compile Include="FrontEnd/CCS/Integration.fs" />
      <!-- FrontEnd - Project Loading (public API: .fidproj → PSG) -->
      <Compile Include="FrontEnd/ProjectLoader.fs" />
      <!-- Platform Templates -->
      <Compile Include="FrontEnd/Templates/TemplateTypes.fs" />
      <Compile Include="FrontEnd/Templates/TemplateLoader.fs" />

      <!-- Alex CodeGeneration - TypeMapping first (no deps) -->
      <Compile Include="MiddleEnd/Alex/CodeGeneration/TypeMapping.fs" />
      <Compile Include="MiddleEnd/Alex/CodeGeneration/CallableSymbols.fs" />

      <!-- Values - the names emission derives for what it emits (no pass, no counter) -->
      <Compile Include="MiddleEnd/Alex/Traversal/Values.fs" />


      <!-- Alex Traversal - PSGZipper: Pure Huet zipper for navigation -->
      <Compile Include="MiddleEnd/Alex/Traversal/PSGZipper.fs" />

      <!-- Alex Traversal - ScopeContext: Principled scope management for operation accumulation -->
      <Compile Include="MiddleEnd/Alex/Traversal/ScopeContext.fs" />

      <!-- Alex Traversal - TransferTypes: Types witnesses receive (ctx: WitnessContext) -->
      <Compile Include="MiddleEnd/Alex/Traversal/TransferTypes.fs" />


      <!-- Alex Traversal - Single-Phase Nanopasses (Post-order traversal with nested accumulators) -->
      <Compile Include="MiddleEnd/Alex/Traversal/CoverageValidation.fs" />
      <Compile Include="MiddleEnd/Alex/Traversal/NanopassArchitecture.fs" />

      <!-- Alex CodeGeneration -->

      <!-- Alex XParsec - Composable PSG pattern matchers -->
      <Compile Include="MiddleEnd/Alex/XParsec/PSGCombinators.fs" />
      <Compile Include="MiddleEnd/Alex/XParsec/Extensions.fs" />

      <!-- Alex Elements - Atomic MLIR ops (internal, XParsec-based) -->
      <Compile Include="MiddleEnd/Alex/Elements/MLIRAtomics.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/MemRefElements.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/ArithElements.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/SCFElements.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/FuncElements.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/IndexElements.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/CombElements.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/HWElements.fs" />
      <Compile Include="MiddleEnd/Alex/Elements/SeqElements.fs" />

      <!-- Alex Elision Patterns - Composable MLIR templates (public, XParsec-based) -->
      <Compile Include="MiddleEnd/Alex/Patterns/MemoryPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/DUPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/RecordPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/HardwareModulePatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/MemRefPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/CollectionPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/ClosurePatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/ControlFlowPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/LiteralPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/ContinuationPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/StringPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/ApplicationPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/FunctionPointerPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/PlatformPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/MmioPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/BorrowedViewPatterns.fs" />
      <Compile Include="MiddleEnd/Alex/Patterns/MappedViewPatterns.fs" />

      <!-- Alex Witnesses - Category-based MLIR generation -->
      <Compile Include="MiddleEnd/Alex/Witnesses/LiteralWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/TypeAnnotationWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/IntrinsicWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/FunctionPointerWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/LazyWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/SeqWitness.fs" />
      <!-- PRD-13a: Core Collections Witnesses -->
      <Compile Include="MiddleEnd/Alex/Witnesses/ListWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/MapWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/SetWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/OptionWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/ControlFlowWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/MatchWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/RecordWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/DUWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/MemoryWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/PlatformWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/MmioWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/BorrowedViewWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/MappedViewWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/StructuralWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/HardwareModuleWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/KernelModuleWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/BindingWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/VarRefWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/MutableAssignmentWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/MemoryIntrinsicWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/StringIntrinsicWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/ArithIntrinsicWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/ApplicationWitness.fs" />
      <Compile Include="MiddleEnd/Alex/Witnesses/LambdaWitness.fs" />

      <!-- Alex Traversal - Witness Registry (global registry of all nanopasses) -->
      <Compile Include="MiddleEnd/Alex/Traversal/WitnessRegistry.fs" />

      <!-- Alex Traversal - MLIR Transfer via Zipper + XParsec (pull model) -->
      <Compile Include="MiddleEnd/Alex/Traversal/StaticStorageValidation.fs" />
      <Compile Include="MiddleEnd/Alex/Traversal/MLIRTransfer.fs" />
      <Compile Include="MiddleEnd/Alex/Traversal/XDCTransfer.fs" />
      <Compile Include="MiddleEnd/Alex/Traversal/SMTTransfer.fs" />

      <!-- Alex Pipeline Types -->
      <Compile Include="MiddleEnd/Alex/Pipeline/CompilationTypes.fs" />

      <!-- Alex Pipeline - MLIR Nanopasses (MLIR→MLIR transformations) -->
      <Compile Include="MiddleEnd/Alex/Pipeline/MLIRNanopass.fs" />

      <!-- MiddleEnd - MLIR Generation (Public API: PSG → MLIR) -->
      <Compile Include="MiddleEnd/MLIRGeneration.fs" />

      <!-- BackEnd - LLVM -->
      <Compile Include="BackEnd/LLVM/Lowering.fs" />
      <Compile Include="BackEnd/LLVM/Codegen.fs" />
      <Compile Include="BackEnd/LLVM/Pipeline.fs" />
      <!-- MCU: in-process BAREWire layout, owned assembly, vendor tools and probe SDK -->
      <Compile Include="BackEnd/MCU/EspImage.fs" />
      <Compile Include="BackEnd/MCU/Target.fs" />
      <Compile Include="BackEnd/MCU/Tools.fs" />
      <Compile Include="BackEnd/MCU/Layout.fs" />
      <Compile Include="BackEnd/MCU/XtensaTarget.fs" />
      <Compile Include="BackEnd/MCU/XtensaLayout.fs" />
      <Compile Include="BackEnd/MCU/Image.fs" />
      <Compile Include="BackEnd/MCU/XtensaImage.fs" />
      <Compile Include="BackEnd/MCU/Probe.fs" />
      <Compile Include="BackEnd/MCU/Pipeline.fs" />

      <!-- BackEnd - CIRCT -->
      <Compile Include="BackEnd/CIRCT/Lowering.fs" />

      <Compile Include="BackEnd/CIRCT/Pipeline.fs" />

      <!-- BackEnd - AIE -->
      <Compile Include="BackEnd/AIE/Lowering.fs" />
      <Compile Include="BackEnd/AIE/Pipeline.fs" />

      <!-- BackEnd - GPU -->
      <Compile Include="BackEnd/GPU/Lowering.fs" />
      <Compile Include="BackEnd/GPU/Pipeline.fs" />

      <!-- BackEnd - Artifact Verification (closed-loop HDL/constraint consistency) -->
      <Compile Include="BackEnd/ArtifactVerification.fs" />

      <!-- Core - Pipeline Resolution (AFTER backends, BEFORE orchestrator) -->
      <Compile Include="Core/PlatformPipeline.fs" />
      <!-- CLI Output (colored diagnostics — before orchestrator so it can emit) -->
      <Compile Include="CLI/Output.fs" />
      <!-- Core - Top-level Compilation Orchestration (AFTER all components) -->
      <Compile Include="Core/DeviceAccessEvidence.fs" />
      <Compile Include="Core/CompilationOrchestrator.fs" />


      <!-- CLI Infrastructure -->
      <Compile Include="CLI/Diagnostics/Types.fs" />
      <Compile Include="CLI/Diagnostics/EnvironmentInfo.fs" />
      <Compile Include="CLI/Diagnostics/ToolChainVerification.fs" />
      <Compile Include="CLI/Commands/VerifyCommand.fs" />
      <Compile Include="CLI/Commands/DoctorCommand.fs" />

      <!-- CLI - Composer Entry Point -->
      <Compile Include="CLI/Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <!-- CCS: F# Native Compiler Services (native type universe) -->
    <ProjectReference Include="$(ClefCompilerServiceProject)" />
    <!-- TUI foundation (Color/Style types now, full TUI later) -->
    <ProjectReference Include="../../Thuja/src/Thuja/Thuja.fsproj" />
    <PackageReference Include="XParsec" Version="0.3.0" />
    <PackageReference Include="Argu" Version="6.1.1" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.2.42" />
  </ItemGroup>

</Project>
